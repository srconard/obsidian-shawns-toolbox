{
	"name": "shawns-toolbox",
	"version": "1.6.2",
	"description": "Note status control (phase + ongoing with change dates, plus a signed note-log entry per transition), checkbox completion stamping, and block summarizer.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node esbuild.config.mjs production",
		"dev:vault": "node esbuild.vault.mjs",
		"watch:vault": "node esbuild.vault.mjs watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint main.ts settings.ts checkbox-handler.ts block-summarizer.ts"
	},
	"keywords": [],
	"author": "Shawn",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.20.0",
		"obsidian": "^1.11.4",
		"typescript": "^5.3.0",
		"vitest": "^4.1.10"
	}
}
